{
  "name": "personal-progress-tracking",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "wrangler pages dev --compatibility-date=2024-12-01 --d1=DB --persist-to=.wrangler/state/v3/d1 --proxy=4200",
    "db:create": "wrangler d1 create progress-tracking-db",
    "db:migrate": "wrangler d1 execute progress-tracking-db --local --file=migrations/0001_initial_schema.sql",
    "db:migrate:remote": "wrangler d1 execute progress-tracking-db --remote --file=migrations/0001_initial_schema.sql",
    "deploy": "ng build && wrangler pages deploy dist/personal-progress-tracking/browser"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.69.0"
  }
}
